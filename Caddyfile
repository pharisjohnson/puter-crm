# Production with custom domain - auto HTTPS via Let's Encrypt
crm.noonstudio.africa {
    root * /var/www/html

    # 1. Proxy API to PocketBase (first - highest priority)
    route /api/* {
        reverse_proxy pocketbase:8090
    }

    # 2. Static files
    route {
        file_server
    }

    # 3. SPA fallback (last)
    route {
        try_files {path} /index.html
    }
}