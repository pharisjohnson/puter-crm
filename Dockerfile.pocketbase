# Build PocketBase image locally
FROM alpine:3.20

RUN apk add --no-cache ca-certificates

WORKDIR /pb

# Copy the Linux binary
COPY pocketbase-linux/pocketbase /pb/pocketbase

RUN chmod +x /pb/pocketbase

EXPOSE 8090

CMD ["./pocketbase", "serve", "--http=0.0.0.0:8090", "--dir=/pb_data", "--publicDir=/pb_public"]